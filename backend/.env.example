# Core backend settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-backend.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
FRONTEND_URL=https://your-frontend.example.com
# Required certificate logo filename from public/assets. No fallback logo is used.
NEXT_PUBLIC_LOGO_LIGHT=dark.png
DJANGO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DJANGO_TIME_ZONE=Asia/Dhaka
PASSWORD_RESET_TIMEOUT=900

# Rate limits
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_AUTH_RATE=10/minute
THROTTLE_PASSWORD_RESET_RATE=5/hour
THROTTLE_AI_RATE=20/hour
THROTTLE_UPLOAD_RATE=60/hour

# Local uploads (use only for development)
MEDIA_STORAGE_BACKEND=local
MEDIA_URL=/media/
AVATAR_MAX_UPLOAD_SIZE=5242880
COURSE_THUMBNAIL_MAX_UPLOAD_SIZE=8388608
MAX_UPLOAD_SIZE=104857600

# Vercel Blob storage
# Set MEDIA_STORAGE_BACKEND=vercel_blob and provide:
# BLOB_STORE_ID=replace-with-store-id
# BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
# Optional: MEDIA_STORAGE_ACCESS=public

# Railway Storage Bucket / S3-compatible production storage
# Set MEDIA_STORAGE_BACKEND=s3 and either inject Railway's BUCKET,
# ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION, ENDPOINT variables or use:
# MEDIA_STORAGE_BUCKET_NAME=
# MEDIA_STORAGE_ACCESS_KEY_ID=
# MEDIA_STORAGE_SECRET_ACCESS_KEY=
# MEDIA_STORAGE_REGION=auto
# MEDIA_STORAGE_ENDPOINT_URL=https://storage.railway.app
# MEDIA_STORAGE_ADDRESSING_STYLE=virtual
# MEDIA_STORAGE_LOCATION=media

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=PyLearn <noreply@example.com>

# Admin bootstrap
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-strong-admin-password

# AI provider key encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_ENCRYPTION_KEY=replace-with-fernet-key

# Firebase Admin (verifies student Google sign-in ID tokens)
FIREBASE_PROJECT_ID=your-project-id
# One-line JSON or base64-encoded JSON for a Firebase service-account key.
# In Google-hosted environments, leave blank and use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_JSON=
